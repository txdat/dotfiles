{
  "name": "pyright-lsp",
  "description": "Python language server",
  "version": "1.0.0",
  "author": {
    "name": "txdat"
  },
  "lspServers": {
    "pyright": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".py": "python"
      },
      "startupTimeout": 30000
    }
  }
}
