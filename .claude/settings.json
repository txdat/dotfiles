{
  "permissions": {
    "allow": [
      "Read(~/.dotfiles/.ai-shared/**)",
      "Bash(~/.dotfiles/.ai-shared/bin/**)",
      "mcp__sverklo__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/.ai-shared/bin/gate-check",
            "if": "Skill(dev:*)"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "tsgo-lsp@txdat-local": true,
    "pyright-lsp@txdat-local": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "mongodb@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "txdat-local": {
      "source": {
        "source": "directory",
        "path": "~/.dotfiles/.claude/marketplace"
      }
    }
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": true,
  "mcpServers": {
    "sverklo": {
      "command": "npx",
      "args": [
        "sverklo"
      ]
    }
  }
}
