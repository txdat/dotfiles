#!/bin/bash
# SessionStart hook (type: command) — inject the repo's handoff, if one
# exists, so a fresh session sees prior state without being told to
# look. Stdout becomes session context. Must always exit 0.
set -uo pipefail

DIR="$HOME/.cache/ai-handoff"
[[ -d "$DIR" ]] || exit 0

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
[[ -n "$cwd" && -d "$cwd" ]] || exit 0
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
base=$(basename "$root")

# Newest handoff matching this repo (exact name or plan-suffixed).
newest=$(ls -t "$DIR/$base.md" "$DIR/$base"-*.md 2>/dev/null | head -1)
[[ -n "$newest" && -f "$newest" ]] || exit 0

printf 'A session handoff exists for this repo (%s). It reflects prior-session state; where it and any compaction summary disagree, the handoff wins. Delete it once its work ships.\n\n' "$newest"
head -80 "$newest"
exit 0
