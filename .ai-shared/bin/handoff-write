#!/bin/bash
# PreCompact + SessionEnd hook (type: command) — deterministic session
# handoff snapshot. Pure script, no agent: it records verifiable repo
# state; narrative sections (Goal/Blockers/Remaining Work) are the live
# session's duty when leaving unfinished planless work, and are
# preserved here if present. Must always exit 0.
set -uo pipefail

DIR="$HOME/.cache/ai-handoff"
mkdir -p "$DIR"
find "$DIR" -maxdepth 1 -type f -name '*.md' -mtime +7 -delete 2>/dev/null

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
[[ -n "$cwd" && -d "$cwd" ]] || exit 0
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
base=$(basename "$root")

# Name: <repo-basename>[-<plan-slug>].md. A worktree's root basename is
# already <repo>-<slug> — use as-is. Otherwise derive the slug from the
# single active plan (Status neither archived nor abandoned; prefer the
# single in-progress one); ambiguous or none → no suffix.
name="$base"
plan="" plan_status=""
if [[ "$root" != /tmp/ai-worktrees/* ]]; then
  active=() in_progress=()
  for f in "$root"/docs/plans/*.md; do
    [[ -f "$f" ]] || continue
    st=$(sed -n 's/^Status:[[:space:]]*\([a-z-]*\).*/\1/p' "$f" | head -1)
    [[ "$st" == archived || "$st" == abandoned ]] && continue
    active+=("$f:$st")
    [[ "$st" == in-progress ]] && in_progress+=("$f:$st")
  done
  pick=""
  [[ ${#active[@]} -eq 1 ]] && pick="${active[0]}"
  [[ -z "$pick" && ${#in_progress[@]} -eq 1 ]] && pick="${in_progress[0]}"
  if [[ -n "$pick" ]]; then
    plan="${pick%:*}" plan_status="${pick##*:}"
    slug=$(basename "$plan" .md | awk -F_ '{print $NF}')
    [[ -n "$slug" ]] && name="$base-$slug"
  fi
fi
out="$DIR/$name.md"

# Preserve agent-written narrative (everything from the first narrative
# heading onward) across snapshot rewrites.
narrative=""
[[ -f "$out" ]] && narrative=$(awk '/^## (Goal|Blockers|Remaining Work)/{found=1} found' "$out")

{
  printf '# Handoff: %s — %s (script snapshot)\n\n' "$base" "$(date -Is)"
  printf '## Repo State (verified at snapshot time)\n'
  printf 'root: %s\n' "$root"
  printf 'branch: %s\n' "$(git -C "$root" branch --show-current 2>/dev/null)"
  printf 'head: %s\n' "$(git -C "$root" log -1 --format='%h %s' 2>/dev/null)"
  printf 'recent: %s\n' "$(git -C "$root" log -5 --format='%h' 2>/dev/null | tr '\n' ' ')"
  printf 'status:\n'
  git -C "$root" status --porcelain 2>/dev/null | head -30 | sed 's/^/  /'
  printf 'worktrees:\n'
  git -C "$root" worktree list 2>/dev/null | sed 's/^/  /'
  if [[ -n "$plan" ]]; then
    printf '\n## Current Plan\n%s — Status: %s\n' "$plan" "$plan_status"
  fi
  if [[ -n "$narrative" ]]; then
    printf '\n%s\n' "$narrative"
  fi
} >"$out" 2>/dev/null

exit 0
